{
    "cmake.buildDirectory": "${workspaceFolder}/build/Windows-MinGW-x64",
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "cmake.preferredGenerators": [
        "Ninja",
        "MinGW Makefiles",
        "Visual Studio 17 2022"
    ],
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "windows-mingw-debug",
    "cmake.buildPreset": "windows-mingw-debug",
    "cmake.environment": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/Tools/Ninja;C:/Qt/6.9.3/mingw_64/bin;${env:PATH}"
    },
    "cmake.configureArgs": [
        "-DCMAKE_PREFIX_PATH=C:/Qt/6.9.3/mingw_64",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_CXX_COMPILER=C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "-DCMAKE_C_COMPILER=C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "-DCMAKE_MAKE_PROGRAM=C:/Qt/Tools/Ninja/ninja.exe"
    ],
    "cmake.copyCompileCommands": "${workspaceFolder}/build/Windows-MinGW-x64/compile_commands.json",
    "cmake.debugConfig": {
        "targetArchitecture": "x64",
        "externalConsole": false,
        "stopAtEntry": false,
        "environment": [
            {
                "name": "PATH",
                "value": "C:/Qt/6.9.3/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
            },
            {
                "name": "QT_PLUGIN_PATH",
                "value": "C:/Qt/6.9.3/mingw_64/plugins"
            }
        ]
    },
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.compilerPath": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/ui",
        "${workspaceFolder}/build/Windows-MinGW-x64",
        "${workspaceFolder}/build/Windows-MinGW-x64/OpenVegas_autogen/include",
        "${workspaceFolder}/build-pro/ui_headers",
        "C:/Qt/6.9.3/mingw_64/include",
        "C:/Qt/6.9.3/mingw_64/include/QtCore",
        "C:/Qt/6.9.3/mingw_64/include/QtGui",
        "C:/Qt/6.9.3/mingw_64/include/QtWidgets"
    ],
    "C_Cpp.default.defines": [
        "QT_CORE_LIB",
        "QT_GUI_LIB",
        "QT_WIDGETS_LIB",
        "UNICODE",
        "_UNICODE",
        "WIN32"
    ],
    "files.associations": {
        "*.ui": "xml",
        "*.qrc": "xml",
        "*.pro": "qmake"
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.env.windows": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.9.3/mingw_64/bin;C:/Qt/Tools/Ninja;C:/Program Files/CMake/bin;${env:PATH}",
        "QT_PLUGIN_PATH": "C:/Qt/6.9.3/mingw_64/plugins"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.trimAutoWhitespace": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/build/**": true,
        "**/build-pro/**": true,
        "**/SAMPLES/VEGAS-PRO-22-PROGRAM-FILES/**": true,
        "**/.git/objects/**": true
    },
    "search.exclude": {
        "**/build": true,
        "**/build-pro": true,
        "**/SAMPLES/VEGAS-PRO-22-PROGRAM-FILES": true
    },
    "clangd.arguments": [
        "--background-index",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--pch-storage=memory",
        "--compile-commands-dir=${workspaceFolder}/build/Windows-MinGW-x64",
        "--query-driver=C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "--clang-tidy=false"
    ],
    "clangd.fallbackFlags": [
        "-std=c++17",
        "-I${workspaceFolder}/src",
        "-IC:/Qt/6.9.3/mingw_64/include",
        "-IC:/Qt/6.9.3/mingw_64/include/QtCore",
        "-IC:/Qt/6.9.3/mingw_64/include/QtGui",
        "-IC:/Qt/6.9.3/mingw_64/include/QtWidgets",
        "-DQT_CORE_LIB",
        "-DQT_GUI_LIB",
        "-DQT_WIDGETS_LIB"
    ],
    "debug.onTaskErrors": "showErrors",
    "debug.allowBreakpointsEverywhere": true
}
