{
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": [
          "--background-index",
          "--completion-style=detailed",
          "--header-insertion=never",
          "--pch-storage=memory",
          "--compile-commands-dir=build/Windows_MinGW-x64",
          "--query-driver=C:/Qt/Tools/mingw1310_64/bin/g++.exe",
          "--clang-tidy=false"
        ]
      }
    }
  },
  "languages": {
    "XML": {
      "file_types": ["ui", "qrc"]
    },
    "C++": {
      "tab_size": 4,
      "hard_tabs": false
    },
    "C": {
      "tab_size": 4,
      "hard_tabs": false
    }
  },
  "tab_size": 4,
  "hard_tabs": false,
  "detect_indentation": true,
  "terminal": {
    "env": {
      "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.9.3/mingw_64/bin;C:/Qt/Tools/Ninja;C:/Program Files/CMake/bin;$PATH",
      "QT_PLUGIN_PATH": "C:/Qt/6.9.3/mingw_64/plugins"
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/build/**",
    "**/build-pro/**",
    "**/SAMPLES/VEGAS-PRO-22-PROGRAM-FILES/**"
  ]
}
