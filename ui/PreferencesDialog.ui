<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PreferencesDialog</class>
 <widget class="QDialog" name="PreferencesDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>700</width>
    <height>480</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Preferences</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <widget class="QWidget" name="tabGeneral">
      <attribute name="title">
       <string>General</string>
      </attribute>
      <layout class="QVBoxLayout" name="generalLayout">
       <item>
        <widget class="QCheckBox" name="checkAutoSave">
         <property name="text">
          <string>Enable autosave</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="generalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabFileIo">
      <attribute name="title">
       <string>File I/O</string>
      </attribute>
      <layout class="QVBoxLayout" name="fileIoLayout">
       <item>
        <widget class="QLabel" name="fileIoInfo">
         <property name="text">
          <string>Vegas FileIO plug-ins are proprietary; OpenVegas uses FFmpeg later. Path below is for reference only.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabPlugins">
      <attribute name="title">
       <string>Plug-Ins</string>
      </attribute>
      <layout class="QVBoxLayout" name="pluginsLayout">
       <item>
        <widget class="QLabel" name="vegasPathLabel">
         <property name="text">
          <string>Vegas Pro Program Files folder</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="vegasPathRow">
         <item>
          <widget class="QLineEdit" name="vegasPathEdit"/>
         </item>
         <item>
          <widget class="QPushButton" name="browseVegasButton">
           <property name="text">
            <string>Browse…</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="ofxPathLabel">
         <property name="text">
          <string>OFX folder (optional override)</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="ofxPathRow">
         <item>
          <widget class="QLineEdit" name="ofxPathEdit"/>
         </item>
         <item>
          <widget class="QPushButton" name="browseOfxButton">
           <property name="text">
            <string>Browse…</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCheckBox" name="checkUseVegasOfx">
         <property name="text">
          <string>Scan OFX from Vegas Pro install / sample folder</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="pluginsWarning">
         <property name="text">
          <string>Do not commit build/vegas-runtime or copied Program Files into git. Debug default: SAMPLES/VEGAS-PRO-22-PROGRAM-FILES.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="pluginsSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabVideo">
      <attribute name="title">
       <string>Video</string>
      </attribute>
      <layout class="QVBoxLayout" name="videoLayout">
       <item>
        <widget class="QLabel" name="hwIntro">
         <property name="text">
          <string>Hardware acceleration is driven through FFmpeg. Every option below is verified by a short trial run before it is used — an accelerator your machine cannot run falls back to software instead of failing the render.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="hwDecodeGroup">
         <property name="title">
          <string>Decoding (playback and scrubbing)</string>
         </property>
         <layout class="QVBoxLayout" name="hwDecodeLayout">
          <item>
           <widget class="QCheckBox" name="checkHwDecode">
            <property name="text">
             <string>Use hardware decoding (DXVA2 / D3D11VA / CUDA — VLD)</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="hwDecodeRow">
            <item>
             <widget class="QLabel" name="hwDecodeLabel">
              <property name="text">
               <string>Method</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="hwDecodeCombo"/>
            </item>
            <item>
             <spacer name="hwDecodeSpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="hwEncodeGroup">
         <property name="title">
          <string>Encoding (Render As)</string>
         </property>
         <layout class="QVBoxLayout" name="hwEncodeLayout">
          <item>
           <layout class="QHBoxLayout" name="hwEncodeRow">
            <item>
             <widget class="QLabel" name="hwEncodeLabel">
              <property name="text">
               <string>Encoder</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="hwEncodeCombo"/>
            </item>
            <item>
             <widget class="QPushButton" name="hwDetectButton">
              <property name="text">
               <string>Detect…</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="hwStatusLabel">
            <property name="text">
             <string/>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="videoSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabVst">
      <attribute name="title">
       <string>Audio Plug-Ins</string>
      </attribute>
      <layout class="QVBoxLayout" name="vstLayout">
       <item>
        <widget class="QLabel" name="sharedFxLabel">
         <property name="text">
          <string>Standard VEGAS Pro (Sound Forge) audio effects</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="sharedFxModeCombo">
         <item>
          <property name="text">
           <string>Replace with your own plugin implementations</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Disable your own plugin implementations</string>
          </property>
         </item>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="sharedFxHint">
         <property name="text">
          <string>Effects such as Chorus, Reverb, Track EQ and Track Compressor exist both as the installed VEGAS plug-in and as an OpenVegas implementation of the same name. Replacing offers OpenVegas's version; disabling offers the VEGAS plug-in itself, with its own dialog. Effects OpenVegas has no implementation for always come from the plug-in.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="Line" name="sharedFxSeparator">
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="vstIntro">
         <property name="text">
          <string>Folders scanned for VST1/VST2 (.dll) and VST3 (.vst3). Plug-ins found here are hosted and processed; VST3 needs the Steinberg SDK to have been present at build time.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="vst1Label">
         <property name="text">
          <string>VST1 search paths (one per line)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="vst1PathsEdit">
         <property name="maximumBlockCount">
          <number>0</number>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="vst2Label">
         <property name="text">
          <string>VST2 search paths (one per line)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="vst2PathsEdit">
         <property name="maximumBlockCount">
          <number>0</number>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="vst3Label">
         <property name="text">
          <string>VST3 search paths (one per line)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="vst3PathsEdit"/>
       </item>
       <item>
        <layout class="QHBoxLayout" name="vstBtnRow">
         <item>
          <widget class="QPushButton" name="vstDefaultsButton">
           <property name="text">
            <string>Reset to defaults</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="vstRescanButton">
           <property name="text">
            <string>Rescan</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="vstBtnSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="vstScanStatus">
         <property name="text">
          <string/>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>PreferencesDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>PreferencesDialog</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
</ui>
