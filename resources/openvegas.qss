}

QLabel#aefxPluginTitle {
  color: #111111;
  background: transparent;
  font-weight: 600;
}

QWidget#aefxBuiltinBody {
  background-color: #c8c8c8;
  color: #111111;
}

QLabel#aefxFaderValue,
QLabel#aefxFaderLabel,
QLabel#aefxParamLabel,
QLabel#aefxParamValue {
  color: #111111;
  background: transparent;
}

QLabel#aefxFaderRange {
  color: #444444;
  background: transparent;
  font-size: 10px;
}

QCheckBox#aefxCheck {
  color: #111111;
  background: transparent;
  spacing: 6px;
}

QSlider#aefxVFader::groove:vertical {
  background: #888888;
  width: 6px;
  border: 1px solid #666666;
}

QSlider#aefxVFader::handle:vertical {
  background: #f0f0f0;
  border: 1px solid #555555;
  height: 10px;
  margin: 0 -4px;
}

QSlider#aefxHSlider::groove:horizontal {
  background: #888888;
  height: 6px;
  border: 1px solid #666666;
}

QSlider#aefxHSlider::sub-page:horizontal {
  background: #5a5a5a;
}

QSlider#aefxHSlider::handle:horizontal {
  background: #f0f0f0;
  border: 1px solid #555555;
  width: 10px;
  margin: -4px 0;
}

QDoubleSpinBox#aefxSpin {
  background-color: #ffffff;
  border: 1px solid #666666;
  color: #111111;
  padding: 1px 4px;
  min-height: 18px;
}

QWidget#aefxVstPage {
  background-color: #101010;
}

QWidget#aefxVstChrome {
  background-color: #1c1c1c;
  border-bottom: 1px solid #333333;
}

QLabel#aefxVstChromeTitle {
  color: #e0e0e0;
  background: transparent;
  font-weight: 600;
}

QWidget#aefxVstStage {
  background-color: #0c0c0c;
}

QLabel#aefxVstName {
  color: #f0f0f0;
  background: transparent;
}

QLabel#aefxVstFmt {
  color: #0078d7;
  background: transparent;
}

QLabel#aefxVstHint {
  color: #888888;
  background: transparent;
  max-width: 420px;
}

QProgressBar#aefxMeter {
  background-color: #2a2a2a;
  border: 1px solid #555555;
  border-radius: 0;
}

QProgressBar#aefxMeter::chunk {
  background-color: #3cb370;
}

QToolButton#aefxBandBtn {
  background-color: #e8e8e8;
  border: 1px solid #888888;
  color: #111111;
  padding: 0;
}

QToolButton#aefxBandBtn:checked {
  background-color: #0078d7;
  border-color: #005a9e;
  color: #ffffff;
}

QTabWidget#aefxEqTabs::pane {
  border: 1px solid #666666;
  background: #d8d8d8;
}

QTabWidget#aefxEqTabs QTabBar::tab {
  background: #c8c8c8;
  color: #222222;
  padding: 4px 12px;
  border: 1px solid #888888;
}

QTabWidget#aefxEqTabs QTabBar::tab:selected {
  background: #e8e8e8;
}

/* Vegas-style Warning (Delete Track with events, etc.) */
QDialog#confirmWarningDialog {
  background-color: #1e1e1e;
  color: #ffffff;
}

QLabel#confirmWarningMessage {
  background: transparent;
  color: #ffffff;
  font-size: 12px;
  padding: 0;
}

QCheckBox#confirmWarningDontShow {
  background: transparent;
  color: #e8e8e8;
  spacing: 6px;
}

QCheckBox#confirmWarningDontShow::indicator {
  width: 13px;
  height: 13px;
  border: 1px solid #c8c8c8;
  background: #1e1e1e;
}

QCheckBox#confirmWarningDontShow::indicator:checked {
  background: #1e1e1e;
  image: none;
  border: 1px solid #c8c8c8;
}

QPushButton#confirmWarningYes,
QPushButton#confirmWarningNo {
  background-color: #2b2b2b;
  border: 1px solid #555555;
  color: #ffffff;
  min-width: 72px;
  min-height: 22px;
  padding: 3px 14px;
}

QPushButton#confirmWarningYes:hover,
QPushButton#confirmWarningNo:hover {
  background-color: #383838;
}

QPushButton#confirmWarningYes:pressed,
QPushButton#confirmWarningNo:pressed {
  background-color: #444444;
}

