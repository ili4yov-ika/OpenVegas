}

QSlider#mixerZoom::groove:horizontal {
  height: 3px;
  background: #333;
  border-radius: 1px;
}

QSlider#mixerZoom::handle:horizontal {
  width: 8px;
  height: 10px;
  margin: -4px 0;
  background: #aaa;
  border-radius: 1px;
}

