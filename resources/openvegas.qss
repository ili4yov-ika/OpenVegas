/* OpenVegas theme — closer to Vegas Pro 22 / SAMPLES tokens */
QWidget {
  background-color: #1a1a1a;
  color: #e0e0e0;
  font-family: "Segoe UI", Tahoma, sans-serif;
  font-size: 12px;
}

QMainWindow, QDialog, QMenuBar, QStatusBar {
  background-color: #1a1a1a;
  color: #e0e0e0;
}

QMenuBar {
  background-color: #1e1e1e;
  border-bottom: 1px solid #333333;
  spacing: 0px;
  padding: 0px;
  min-height: 20px;
}

QMenuBar::item {
  padding: 2px 8px;
  background: transparent;
}

QMenuBar::item:selected {
  background-color: #333333;
}

QMenu {
  background-color: #2b2b2b;
  border: 1px solid #444444;
}

QMenu::item:selected {
  background-color: #0078d7;
}

QWidget#mainToolBarHost,
QWidget#mediaToolbar,
QWidget#previewToolbar,
QWidget#timelineToolsHost {
  background-color: #2a2a2a;
  border-bottom: 1px solid #1a1a1a;
}

QWidget#timelineToolsHost {
  border-top: 1px solid #333333;
  border-bottom: none;
}

QWidget#timelineRateCol {
  background-color: #242424;
  border-right: 1px solid #111111;
}

QWidget#timelineToolsRest {
  background-color: #2a2a2a;
}

QStatusBar#mainStatusBar,
QStatusBar {
  background-color: #222222;
  border-top: 1px solid #111111;
  color: #b0b0b0;
  min-height: 22px;
  max-height: 24px;
  padding: 0 4px;
}

QStatusBar::item {
  border: none;
}

QLabel#statusProject,
QLabel#statusAudio,
QLabel#statusRecord {
  color: #a8a8a8;
  font-size: 11px;
  padding: 0 8px;
  background: transparent;
  border-left: 1px solid #333333;
}

QToolButton#iconBtn {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 2px;
  padding: 0;
  margin: 0;
  color: #a0a0a0;
}

QToolButton#iconBtn:hover {
  background-color: #333333;
  color: #e0e0e0;
}

QToolButton#iconBtn:checked,
QToolButton#iconBtn:pressed {
  background-color: #0078d7;
  border-color: #0078d7;
  color: #ffffff;
}

QToolButton#iconBtn:disabled {
  color: #555555;
  opacity: 0.45;
}

QToolButton#textToolBtn {
  background: transparent;
  border: none;
  color: #c0c0c0;
  padding: 2px 6px;
}

QToolButton#textToolBtn:hover {
  color: #ffffff;
  background-color: #333333;
}

QToolButton#msBtn {
  background: transparent;
  border: none;
  color: #e8e8e8;
  font-size: 11px;
  font-weight: 600;
  padding: 0;
}

QToolButton#msBtn:hover {
  color: #ffffff;
  background-color: #333333;
}

QToolButton#msBtn:checked {
  background: #0078d7;
  color: #fff;
  border: 1px solid #0078d7;
  border-radius: 2px;
}

QToolButton#msBtn:disabled {
  color: #555;
}

QToolButton#panelTabIco,
QToolButton#masterLock {
  background: transparent;
  border: none;
  color: #c8c8c8;
  padding: 0;
}

QToolButton#panelTabIco:hover,
QToolButton#masterLock:hover {
  color: #ffffff;
  background-color: #333;
}

QWidget#masterBusFooter {
  background: #252525;
  border-top: 1px solid #1a1a1a;
}

QLabel#masterBusTab {
  background: transparent;
  border: none;
  color: #d0d0d0;
  font-size: 11px;
  padding: 0;
}

QLabel#previewPanelTab {
  background: #252525;
  border-top: 1px solid #333;
  color: #ccc;
  font-size: 11px;
  padding-left: 6px;
}

QWidget#vuScale {
  background: transparent;
}

QDoubleSpinBox#rateSpin {
  background: #1a1a1a;
  border: 1px solid #444;
  color: #e0e0e0;
  padding: 1px 4px;
  min-height: 18px;
  max-height: 20px;
}

QWidget#rateSlider {
  max-height: 20px;
  min-width: 64px;
  background: transparent;
}

QLabel#rateValue {
  color: #e0e0e0;
  font-size: 11px;
  font-family: Consolas, "Courier New", monospace;
}

QWidget#miniVu {
  background: transparent;
}

QFrame#miniVuCh {
  background-color: #0a0a0a;
  border: 1px solid #222;
}

QFrame#miniVuFill {
  background-color: #3cb371;
  border: none;
}

QSlider#masterFader {
  background: transparent;
}

QSlider#masterFader::groove:vertical {
  width: 2px;
  background: #e0e0e0;
  border: none;
  margin: 0 7px;
}

QSlider#masterFader::handle:vertical {
  height: 14px;
  width: 12px;
  margin: 0 -5px;
  background: #f0f0f0;
  border: 1px solid #9a9a9a;
  border-radius: 1px;
}

QSlider#masterFader::add-page:vertical,
QSlider#masterFader::sub-page:vertical {
  background: transparent;
}

QFrame#toolbarSep {
  color: #444444;
  max-width: 1px;
  margin: 0 3px;
  background: #444444;
  border: none;
}

QSplitter::handle {
  background-color: #2b2b2b;
}

QSplitter::handle:horizontal {
  width: 3px;
}

QSplitter::handle:vertical {
  height: 3px;
}

QTabWidget::pane {
  border: 1px solid #333333;
  background-color: #1e1e1e;
  top: -1px;
}

QTabBar::tab {
  background-color: #1a1a1a;
  color: #888888;
  padding: 3px 10px;
  border: 1px solid #333333;
  border-top: none;
  margin-right: 1px;
  min-height: 18px;
}

QTabBar::tab:selected {
  background-color: #252525;
  color: #e0e0e0;
}

QTabBar::tab:hover:!selected {
  color: #c0c0c0;
  background-color: #222222;
}

QListWidget, QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
  background-color: #1e1e1e;
  border: 1px solid #333333;
  color: #e0e0e0;
  selection-background-color: #0078d7;
  outline: none;
}

QListWidget::item:selected {
  background-color: #2a4a6a;
  color: #ffffff;
}

QListWidget::item:hover:!selected {
  background-color: #2a2a2a;
}

QPushButton {
  background-color: #2b2b2b;
  border: 1px solid #444444;
  padding: 4px 10px;
  color: #e0e0e0;
}

QPushButton:hover {
  background-color: #333333;
}

QPushButton:pressed {
  background-color: #3a3a3a;
}

QGroupBox {
  border: 1px solid #333333;
  margin-top: 8px;
  padding-top: 8px;
}

QProgressBar#masterMeter {
  background-color: #0d0d0d;
  border: 1px solid #2a2a2a;
  min-width: 12px;
  max-width: 16px;
  border-radius: 0;
}

QProgressBar#masterMeter::chunk {
  background-color: #3cb371;
}

QFrame#previewViewport {
  background-color: #000000;
  border: 1px solid #111111;
}

QWidget#previewFooterHost {
  background-color: #222222;
  border-top: 1px solid #111111;
  max-height: 64px;
}

QLabel#previewLabel {
  background: transparent;
  color: transparent;
  border: none;
}

QWidget#previewToolbar {
  background-color: #2a2a2a;
  border-bottom: 1px solid #1a1a1a;
  min-height: 26px;
  max-height: 28px;
}

QToolButton#previewChip {
  background: #252525;
  border: 1px solid #444444;
  border-radius: 2px;
  color: #c8c8c8;
  padding: 2px 8px;
  font-size: 11px;
}

QToolButton#previewChip:hover {
  background: #333333;
  color: #ffffff;
}

QWidget#previewTransportRow {
  background-color: #222222;
  max-height: 26px;
}

QWidget#previewInfoRow {
  background-color: #222222;
  max-height: 36px;
}

QToolButton#previewTransportBtn {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 2px;
  color: #8ec8f0;
  padding: 0;
  margin: 0;
}

QToolButton#previewTransportBtn:hover {
  color: #b8e0ff;
  background-color: #333333;
}

QToolButton#previewTransportBtn:checked {
  color: #4da3ff;
  background: rgba(0, 120, 215, 0.25);
  border-color: #0078d7;
}

QLabel#previewFooterLeft,
QLabel#previewFooterRight {
  color: #b0b0b0;
  font-size: 10px;
  background: transparent;
  padding: 0;
}

QLabel#previewFooter,
QLabel#rateLabel,
QLabel#recordTime {
  color: #888888;
  font-size: 11px;
  padding: 2px 4px;
}

QLabel#masterPeaks {
  color: #a0a0a0;
  font-size: 10px;
  font-family: Consolas, "Courier New", monospace;
  padding: 0;
  background: transparent;
}

QLabel#masterTitle {
  color: #f0f0f0;
  font-size: 12px;
  font-weight: 500;
  background: transparent;
}

QWidget#masterBusPanel {
  background-color: #1e1e1e;
  border-left: 1px solid #111111;
}

QWidget#mediaEmptyPage {
  background-color: #1a1a1a;
}

QPushButton#importMediaCta {
  background-color: #2f2f2f;
  border: 1px solid #555555;
  color: #e0e0e0;
  padding: 6px 18px;
  border-radius: 2px;
  font-size: 12px;
}

QPushButton#importMediaCta:hover {
  background-color: #3a3a3a;
  border-color: #0078d7;
}

QListWidget#mediaTree {
  background-color: #1e1e1e;
  border: none;
  border-right: 1px solid #2a2a2a;
  outline: none;
  padding: 4px 0;
}

QListWidget#mediaTree::item {
  padding: 4px 10px;
  color: #c0c0c0;
}

QListWidget#mediaTree::item:selected {
  background-color: #0078d7;
  color: #ffffff;
}

QListWidget#mediaTree::item:hover:!selected {
  background-color: #2a2a2a;
}

QListWidget#mediaGrid {
  background-color: #1e1e1e;
  border: none;
  padding: 8px;
  outline: none;
}

QListWidget#mediaGrid::item {
  color: #a0a0a0;
  font-size: 11px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 2px;
  padding: 2px;
}

QListWidget#mediaGrid::item:hover {
  color: #c8c8c8;
  background-color: #252525;
}

QListWidget#mediaGrid::item:selected {
  color: #e0e0e0;
  background-color: #2a2a2a;
  border: 1px solid #0078d7;
}

/* ── Explorer (Vegas-style file browser) ── */
QWidget#explorerPane {
  background-color: #1e1e1e;
}

QWidget#explorerToolbar {
  background-color: #2a2a2a;
  border-bottom: 1px solid #111111;
}

QToolButton#explorerNavBtn {
  background: transparent;
  border: none;
  padding: 0;
}

QToolButton#explorerNavBtn:hover {
  background-color: #3a3a3a;
}

QToolButton#explorerNavBtn:disabled {
  opacity: 0.4;
}

QWidget#explorerPath {
  background-color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 2px;
  min-height: 18px;
  max-height: 20px;
}

QToolButton#explorerCrumb,
QToolButton#explorerCrumbCurrent {
  background: transparent;
  border: none;
  color: #888888;
  font-size: 10px;
  padding: 0 2px;
}

QToolButton#explorerCrumb:hover {
  color: #e0e0e0;
}

QToolButton#explorerCrumbCurrent {
  color: #e0e0e0;
}

QLabel#explorerPathSep {
  color: #666666;
  font-size: 10px;
  padding: 0 1px;
}

QTreeView#explorerTree {
  background-color: #1c1c1c;
  border: none;
  border-right: 1px solid #111111;
  color: #c0c0c0;
  font-size: 11px;
  outline: none;
  show-decoration-selected: 1;
}

QTreeView#explorerTree::item {
  min-height: 18px;
  padding: 1px 2px;
}

QTreeView#explorerTree::item:hover {
  background-color: #2a2a2a;
}

QTreeView#explorerTree::item:selected {
  background-color: #0078d7;
  color: #ffffff;
}

QTreeView#explorerTree::branch {
  background: transparent;
}

QListView#explorerGrid {
  background-color: #1e1e1e;
  border: none;
  outline: none;
  padding: 8px;
  color: #a0a0a0;
  font-size: 10px;
}

QSplitter#explorerSplitter::handle {
  background-color: #111111;
  width: 3px;
}

/* ── Video FX ── */
QWidget#videoFxPane,
QWidget#mediaGeneratorPane,
QWidget#transitionsPane {
  background-color: #1e1e1e;
}

QWidget#fxToolbar {
  background-color: #2a2a2a;
  border-bottom: 1px solid #111111;
}

QWidget#fxSearch {
  background-color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 2px;
  min-height: 18px;
}

QLabel#fxSearchIco {
  color: #666666;
  font-size: 12px;
}

QLineEdit#fxSearchEdit {
  background: transparent;
  border: none;
  color: #e0e0e0;
  font-size: 11px;
  padding: 1px 0;
  selection-background-color: #0078d7;
}

QScrollArea#fxChipsScroll {
  background-color: #252525;
  border: none;
  border-bottom: 1px solid #111111;
}

QWidget#fxChips {
  background-color: #252525;
}

QPushButton#fxChip,
QPushButton#fxChipStar {
  background: transparent;
  border: 1px solid transparent;
  color: #888888;
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 2px;
}

QPushButton#fxChip:hover,
QPushButton#fxChipStar:hover {
  background-color: #333333;
  color: #e0e0e0;
}

QPushButton#fxChip:checked,
QPushButton#fxChipStar:checked {
  background-color: #3a3a3a;
  color: #e0e0e0;
  border-color: #555555;
}

QPushButton#fxChipStar {
  color: #c9a227;
}

QPushButton#fxChipStar:checked {
  color: #e0b030;
}

QListWidget#fxPluginList {
  background-color: #1c1c1c;
  border: none;
  border-right: 1px solid #111111;
  color: #a0a0a0;
  font-size: 11px;
  outline: none;
  padding: 2px 0;
}

QListWidget#fxPluginList::item {
  padding: 3px 8px;
  min-height: 18px;
}

QListWidget#fxPluginList::item:hover {
  background-color: #2a2a2a;
  color: #e0e0e0;
}

QListWidget#fxPluginList::item:selected {
  background-color: #0078d7;
  color: #ffffff;
}

QListWidget#fxPresetGrid {
  background-color: #1e1e1e;
  border: none;
  outline: none;
  padding: 8px;
  color: #a0a0a0;
  font-size: 10px;
}

QListWidget#fxPresetGrid::item {
  color: #a0a0a0;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 2px;
  padding: 2px;
}

QListWidget#fxPresetGrid::item:hover {
  color: #e0e0e0;
  border-color: #0078d7;
}

QListWidget#fxPresetGrid::item:selected {
  color: #e0e0e0;
  border-color: #0078d7;
  background-color: rgba(0, 120, 215, 40);
}

QWidget#fxMeta {
  background-color: #222222;
  border-top: 1px solid #111111;
}

QLabel#fxMetaLine {
  color: #888888;
  font-size: 10px;
}

QSplitter#fxSplitter::handle {
  background-color: #111111;
  width: 3px;
}

QWidget#mediaBinFooter {
  background-color: #1a1a1a;
  border-top: 1px solid #333333;
}

QLabel#mediaMeta {
  background: transparent;
  border: none;
  color: #888888;
  font-size: 11px;
  padding: 0 4px;
}

QPushButton#demoTimelineBtn {
  background-color: #2a2a2a;
  border: 1px solid #555555;
  color: #c8c8c8;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 0 10px;
  border-radius: 2px;
  min-width: 48px;
}

QPushButton#demoTimelineBtn:hover {
  background-color: #3a3a3a;
  border-color: #0078d7;
  color: #ffffff;
}

QPushButton#demoTimelineBtn:pressed {
  background-color: #0078d7;
  border-color: #0078d7;
  color: #ffffff;
}

QLabel#timelineTimecode {
  color: #e0e0e0;
  font-family: Consolas, "Courier New", monospace;
  font-size: 12px;
  padding: 0 8px;
  min-width: 64px;
}

QSlider::groove:horizontal {
  height: 4px;
  background: #333333;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  width: 10px;
  margin: -4px 0;
  background: #a0a0a0;
  border-radius: 2px;
}

QScrollBar:horizontal, QScrollBar:vertical {
  background: #1a1a1a;
  border: none;
  width: 10px;
  height: 10px;
}

QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
  background: #444444;
  min-height: 20px;
  min-width: 20px;
  border-radius: 2px;
}

QScrollBar::add-line, QScrollBar::sub-line {
  width: 0;
  height: 0;
}

QToolTip {
  background-color: #2b2b2b;
  color: #e0e0e0;
  border: 1px solid #444444;
}

/* Welcome — Vegas Pro screenshot fidelity */
QDialog#WelcomeDialog {
  background-color: #1a1a1a;
  border: 1px solid #333333;
}

QWidget#welcomeSide {
  background-color: #161616;
  border-right: 1px solid #2a2a2a;
}

QLabel#brandLogo {
  background-color: transparent;
  border-radius: 4px;
}

QLabel#brandName {
  font-weight: 600;
  font-size: 13px;
  color: #ffffff;
}

QToolButton#welcomeNavBtn {
  background: transparent;
  border: none;
  border-radius: 0;
  color: #a0a0a0;
  padding: 12px 6px 10px;
  font-size: 11px;
}

QToolButton#welcomeNavBtn:hover {
  background-color: #2a2a2a;
  color: #e0e0e0;
}

QToolButton#welcomeNavBtn:checked {
  background-color: #0078d7;
  color: #ffffff;
}

QWidget#welcomeMain {
  background-color: #1a1a1a;
}

QFrame#welcomeHero,
QFrame#welcomeHeroGetting {
  background: transparent;
  border: none;
}

QLabel#welcomeHeroBanner {
  border: none;
  background: transparent;
}

QLabel#newTitle,
QLabel#openTitle {
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  margin-top: 4px;
}

QLabel#labelResolution,
QLabel#labelFramerate,
QLabel#recentLabel {
  color: #c0c0c0;
  font-size: 12px;
}

QComboBox#resolutionCombo,
QComboBox#framerateCombo,
QComboBox#dropFrameCombo {
  background-color: #2a2a2a;
  border: 1px solid #3a3a3a;
  color: #e0e0e0;
  padding: 4px 8px;
  min-height: 22px;
  border-radius: 2px;
}

QComboBox#resolutionCombo:hover,
QComboBox#framerateCombo:hover,
QComboBox#dropFrameCombo:hover,
QComboBox#resolutionCombo:on,
QComboBox#framerateCombo:on,
QComboBox#dropFrameCombo:on {
  border-color: #555555;
}

QToolButton#welcomeAspectCard {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  color: #888888;
  font-size: 10px;
  padding: 6px 4px 4px;
}

QToolButton#welcomeAspectCard:hover {
  background-color: #252525;
  color: #c8c8c8;
}

QToolButton#welcomeAspectCard:checked {
  background-color: #0078d7;
  border-color: #0078d7;
  color: #ffffff;
}

QPushButton#createProjectButton {
  background-color: #3a3a3a;
  border: 1px solid #4a4a4a;
  color: #ffffff;
  padding: 7px 18px;
  border-radius: 2px;
  min-width: 120px;
}

QPushButton#createProjectButton:hover {
  background-color: #454545;
}

QPushButton#advancedSettingsButton,
QPushButton#browseButton {
  background-color: #3a3a3a;
  border: 1px solid #4a4a4a;
  color: #e0e0e0;
  padding: 7px 16px;
  border-radius: 2px;
}

QPushButton#advancedSettingsButton:hover,
QPushButton#browseButton:hover {
  background-color: #454545;
}

QListWidget#recentList {
  background-color: #1e1e1e;
  border: 1px solid #333333;
  outline: none;
}

QListWidget#recentList::item {
  padding: 8px 12px;
  border-bottom: 1px solid #2a2a2a;
}

QListWidget#recentList::item:hover {
  background-color: #333333;
}

QListWidget#recentList::item:selected {
  background-color: #0078d7;
}

QFrame#tutorialCard1,
QFrame#tutorialCard2,
QFrame#tutorialCard3 {
  background-color: #1e1e1e;
  border: 1px solid #333333;
  border-radius: 4px;
}

QFrame#tutorialImg1 {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1a4a6a, stop:1 #2a7aaa);
}

QFrame#tutorialImg2 {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6a2a4a, stop:1 #aa4070);
}

QFrame#tutorialImg3 {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2a4a2a, stop:1 #4a8a4a);
}

QLabel#tutorialLabel1,
QLabel#tutorialLabel2,
QLabel#tutorialLabel3 {
  color: #888888;
  font-size: 11px;
}

QPushButton#welcomeGettingBtn {
  background-color: #2f2f2f;
  border: 1px solid #444444;
  color: #e0e0e0;
  padding: 12px 8px;
  border-radius: 3px;
}

QPushButton#welcomeGettingBtn:hover {
